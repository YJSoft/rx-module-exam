<query id="updateQuestionPassage" action="update">
	<tables>
		<table name="exam_question" />
	</tables>
	<columns>
		<column name="passage_srl" var="passage_srl" default="0" filter="number" />
	</columns>
	<conditions>
		<condition operation="equal" column="question_srl" var="question_srl" filter="number" notnull="notnull" />
		<condition operation="equal" column="document_srl" var="document_srl" filter="number" notnull="notnull" pipe="and" />
	</conditions>
</query>
